# 이 파일을 복사해 .env를 만들고 값을 채운다(.env는 커밋하지 않는다).
# 형식: 키=값 (따옴표·공백 없이). 비워 둔 선택 항목은 기본값을 쓴다.

# ── 필수 ─────────────────────────────────────────────

# 앱 토큰(xapp-로 시작). api.slack.com/apps → 앱 → Basic Information
# → App-Level Tokens → Generate Token and Scopes(범위 connections:write)
SLACK_APP_TOKEN=

# 봇 토큰(xoxb-로 시작). api.slack.com/apps → 앱 → OAuth & Permissions
# → Bot User OAuth Token (워크스페이스에 설치한 뒤에 보인다)
SLACK_BOT_TOKEN=

# 관리자 비공개 채널 ID(C로 시작). 채널 이름 클릭 → 창 맨 아래 "채널 ID".
# 봇을 이 채널에 초대해 둬야 시작한다. 이 채널 멤버가 관리자다.
ADMIN_CHANNEL_ID=

# 사내 vLLM 주소. /v1까지 적는다. 예: http://10.0.0.5:8000/v1
LLM_BASE_URL=

# vLLM에 올라간 모델 이름. 모르면 브라우저에서 {LLM_BASE_URL}/models 를 열어 "id" 값을 쓴다.
LLM_MODEL=

# ── 시험할 때 ────────────────────────────────────────

# 시험 대상자 Slack 사용자 ID(U로 시작), 쉼표로 구분. 예: U012AB3CD,U045EF6GH
# 값이 있으면 이 사람들만 보고 대상자다(정식 운영 때 비운다).
# ID 찾기: Slack에서 프로필 열기 → ⋮(더보기) → "멤버 ID 복사"
TEST_TARGET_USERS=

# 예약 시각(HH:MM, 24시간). 기본: 요청 17:30, 재알림 09:00, 요약 10:00.
# 시험할 때는 지금 몇 분 뒤로 바꾸면 바로 확인할 수 있다. 셋 다 근무일에만 돈다.
REQUEST_TIME=
REMINDER_TIME=
SUMMARY_TIME=

# 늦게 실행해도 되는 시한(HH:MM). 각 시각보다 늦어야 한다.
# 기본: 요청 21:00, 재알림 = 요약 시각, 요약 18:00
REQUEST_DEADLINE=
REMINDER_DEADLINE=
SUMMARY_DEADLINE=

# ── 보통 비워 둔다 ────────────────────────────────────

# vLLM에 API 키가 걸려 있을 때만
LLM_API_KEY=
# 수정 가능 기간(근무일 수, 기본 5, 1~15. 앱 홈 화면 한도 때문에 15까지)
EDIT_WINDOW_WORKDAYS=
# LLM 실패 시 다시 시도 횟수(기본 3)와 간격(초, 기본 60)
LLM_RETRY_COUNT=
LLM_RETRY_INTERVAL_SECONDS=
# LLM 호출 한 번의 최대 대기(초). 기본 120
LLM_TIMEOUT_SECONDS=
# 시간대(기본 Asia/Seoul). 운영 중에는 바꾸지 않는다.
TIMEZONE=
# DB 위치. 상대 경로는 이 폴더(daily-report) 기준. 기본 data/daily_report.db
DB_PATH=
# (환경변수) 소스 폴더 밖에 설치했을 때 .env와 data/가 있는 폴더. 보통 비워 둔다.
# DAILY_REPORT_HOME=
